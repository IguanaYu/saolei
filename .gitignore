# Godot 4+ specific ignores
.godot/
/android/

# IDE / editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

claude.md
.gitignore

# tmp/ 整目录为调试产物（截图/测试脚本/中间产物），新增文件一律不入库；
# 历史已跟踪的 224 个文件不受影响，仍正常跟踪其改动
tmp/

# ZCode agent 工作区目录
.zcode/

# secrets
.env

# Windows 试玩包与导出验证产物
build/

# docs/tmp 下参考图的 Godot 导入缓存（图本身未入库，.import 不得单独入库）
tmp/**/*.import
docs/**/*.import
