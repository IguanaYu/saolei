# Godot 4+ specific ignores
.godot/
/android/

# IDE / editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

claude.md
.gitignore

# 美术生成脚本产物/缓存的 Godot 导入噪音（游戏素材在 assets/ 下，其 .import 需跟踪）
tmp/*.import
tmp/__pycache__/

# 一次性调试运行日志
tmp/*.log

# Kenney 等外部素材源包/压缩包（存放在仓库外 ../素材源包/）
tmp/kenney_*

# secrets
.env

# Windows 试玩包与导出验证产物
build/

# docs/tmp 下参考图的 Godot 导入缓存（图本身未入库，.import 不得单独入库）
tmp/**/*.import
docs/**/*.import
